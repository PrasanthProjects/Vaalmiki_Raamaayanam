[
[
1,
[
"శ్రుత్వా వస్తు సమగ్రం తద్ధర్మార్థసహితం హితమ్ ।",
"వ్యక్తమన్వేషతే భూయో యద్ వృత్తం తస్య ధీమతః"
]
],
[
2,
[
"ఉపస్పృశ్యోదకం సమ్యఙ్మునిః స్థిత్వా కృతాఞ్జలిః ।",
"ప్రాచీనాగ్రేషు దర్భేషు ధర్మేణాన్వేషతే గతిమ్"
]
],
[
3,
[
"రామలక్ష్మణసీతాభీ రాజ్ఞా దశరథేన చ ।",
"సభార్యేణ సరాష్ట్రేణ యత్ ప్రాప్తం తత్ర తత్త్వతః"
]
],
[
4,
[
"హసితం భాషితం చైవ గతిర్యావచ్చ చేష్టితమ్ ।",
"తత్ సర్వం ధర్మవీర్యేణ యథావత్ సంప్రపశ్యతి"
]
],
[
5,
[
"స్త్రీతృతీయేన చ తథా యత్ ప్రాప్తం చరతా వనే ।",
"సత్యసన్ధేన రామేణ తత్ సర్వం చాన్వవైక్షత"
]
],
[
6,
[
"తతః పశ్యతి ధర్మాత్మా తత్ సర్వం యోగమాస్థితః ।",
"పురా యత్ తత్ర నిర్వృత్తం పాణావామలకం యథా"
]
],
[
7,
[
"తత్ సర్వం తత్త్వతో దృష్ట్వా ధర్మేణ స మహామతిః ।",
"అభిరామస్య రామస్య తత్ సర్వం కర్తుముద్యతః"
]
],
[
8,
[
"కామార్థగుణసంయుక్తం ధర్మార్థగుణవిస్తరమ్ ।",
"సముద్రమివ రత్నాఢ్యం సర్వశ్రుతిమనోహరమ్"
]
],
[
9,
[
"స యథా కథితం పూర్వం నారదేన మహాత్మనా ।",
"రఘువంశస్య చరితం చకార భగవాన్ మునిః"
]
],
[
10,
[
"జన్మ రామస్య సుమహద్వీర్యం సర్వానుకూలతామ్ ।",
"లోకస్య ప్రియతాం క్షాన్తిం సౌమ్యతాం సత్యశీలతామ్"
]
],
[
11,
[
"నానా చిత్రాః కథాశ్చాన్యా విశ్వామిత్రసహాయనే ।",
"జానక్యాశ్చ వివాహం చ ధనుషశ్చ విభేదనమ్"
]
],
[
12,
[
"రామరామవివాదం చ గుణాన్ దాశరథేస్తథా ।",
"తథాభిషేకం రామస్య కైకేయ్యా దుష్టభావతామ్"
]
],
[
13,
[
"విఘాతం చాభిషేకస్య రామస్య చ వివాసనమ్ ।",
"రాజ్ఞః శోకం విలాపం చ పరలోకస్య చాశ్రయమ్"
]
],
[
14,
[
"ప్రకృతీనాం విషాదం చ ప్రకృతీనాం విసర్జనమ్ ।",
"నిషాదాధిపసంవాదం సూతోపావర్తనం తథా"
]
],
[
15,
[
"గఙ్గాయాశ్చాపి సంతారం భరద్వాజస్య దర్శనమ్ ।",
"భరద్వాజాభ్యనుజ్ఞానాచ్చిత్రకూటస్య దర్శనమ్"
]
],
[
16,
[
"వాస్తుకర్మ నివేశం చ భరతాగమనం తథా ।",
"ప్రసాదనం చ రామస్య పితుశ్చ సలిలక్రియామ్"
]
],
[
17,
[
"పాదుకాగ్ర్యాభిషేకం చ నన్దిగ్రామనివాసనమ్ ।",
"దణ్డకారణ్యగమనం విరాధస్య వధం తథా"
]
],
[
18,
[
"దర్శనం శరభఙ్గస్య సుతీక్ష్ణేన సమాగమమ్ ।",
"అనసూయాసమాఖ్యాం చ అఙ్గరాగస్య చార్పణమ్"
]
],
[
19,
[
"దర్శనం చాప్యగస్త్యస్య ధనుషో గ్రహణం తథా ।",
"శూర్పణఖ్యాశ్చ సంవాదం విరూపకరణం తథా"
]
],
[
20,
[
"వధం ఖరత్రిశిరసోరుత్థానం రావణస్య చ ।",
