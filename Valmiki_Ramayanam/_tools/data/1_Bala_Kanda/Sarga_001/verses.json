[
[
1,
[
"తపః స్వాధ్యాయనిరతం తపస్వీ వాగ్విదాం వరమ్ ।",
"నారదం పరిపప్రచ్ఛ వాల్మీకిర్మునిపుఙ్గవమ్"
]
],
[
2,
[
"కో న్వస్మిన్సామ్ప్రతం లోకే గుణవాన్కశ్చ వీర్యవాన్ ।",
"ధర్మజ్ఞశ్చ కృతజ్ఞశ్చ సత్యవాక్యో దృఢవ్రతః"
]
],
[
3,
[
"చారిత్రేణ చ కో యుక్తః సర్వభూతేషు కో హితః ।",
"విద్వాన్కః కః సమర్థశ్చ కశ్చైకప్రియదర్శనః"
]
],
[
4,
[
"ఆత్మవాన్కో జితక్రోధో ద్యుతిమాన్కోఽనసూయకః ।",
"కస్య బిభ్యతి దేవాశ్చ జాతరోషస్య సంయుగే"
]
],
[
5,
[
"ఏతదిచ్ఛామ్యహం శ్రోతుం పరం కౌతూహలం హి మే ।",
"మహర్షే త్వం సమర్థోఽసి జ్ఞాతుమేవంవిధం నరమ్"
]
],
[
6,
[
"శ్రుత్వా చైతత్త్రిలోకజ్ఞో వాల్మీకేర్నారదో వచః ।",
"శ్రూయతామితి చామన్త్ర్య ప్రహృష్టో వాక్యమబ్రవీత్"
]
],
[
7,
[
"బహవో దుర్లభాశ్చైవ యే త్వయా కీర్తితా గుణాః ।",
"మునే వక్ష్యామ్యహం బుద్ధ్వా తైర్యుక్తః శ్రూయతాం నరః"
]
],
[
8,
[
"ఇక్ష్వాకువంశప్రభవో రామో నామ జనైః శ్రుతః ।",
"నియతాత్మా మహావీర్యో ద్యుతిమాన్ధృతిమాన్వశీ"
]
],
[
9,
[
"బుద్ధిమాన్నీతిమాన్వాగ్మీ శ్రీమాఞ్ఛ్త్రునిబర్హణః ।",
"విపులాంసో మహాబాహుః కమ్బుగ్రీవో మహాహనుః"
]
],
[
10,
[
"మహోరస్కో మహేష్వాసో గూఢజత్రురరిన్దమః ।",
"ఆజానుబాహుః సుశిరాః సులలాటః సువిక్రమః"
]
],
[
11,
[
"సమః సమవిభక్తాఙ్గః స్నిగ్ధవర్ణః ప్రతాపవాన్ ।",
"పీనవక్షా విశాలాక్షో లక్ష్మీవాఞ్ఛుభలక్షణః"
]
],
[
12,
[
"ధర్మజ్ఞః సత్యసన్ధశ్చ ప్రజానాం చ హితే రతః ।",
"యశస్వీ జ్ఞానసమ్పన్నః శుచిర్వశ్యః సమాధిమాన్"
]
],
[
13,
[
"ప్రజాపతిసమః శ్రీమాన్ ధాతా రిపునిషూదనః ।",
"రక్షితా జీవలోకస్య ధర్మస్య పరిరక్షితా"
]
],
[
14,
[
"రక్షితా స్వస్య ధర్మస్య స్వజనస్య చ రక్షితా  ।",
"వేదవేదాఙ్గతత్త్వజ్ఞో ధనుర్వేదే చ నిష్ఠితః"
]
],
[
15,
[
"సర్వశాస్త్రార్థతత్త్వజ్ఞో స్మృతిమాన్ ప్రతిభానవాన్ ।",
"సర్వలోకప్రియః సాధురదీనాత్మా విచక్షణః"
]
],
[
16,
[
"సర్వదాభిగతః సద్భిః సముద్ర ఇవ సిన్ధుభిః ।",
"ఆర్యః సర్వసమశ్చైవ సదైవ ప్రియదర్శనః"
]
],
[
17,
[
"స చ సర్వ గుణోపేతః కౌసల్యానన్దవర్ధనః ।",
"సముద్ర ఇవ గామ్భీర్యే  ధైర్యేణ హిమవానివ"
]
],
[
18,
[
"విష్ణునా సదృశో వీర్యే సోమవత్ప్రియదర్శనః ।",
"కాలాగ్నిసదృశః క్రోధే క్షమయా పృథివీసమః"
]
],
[
19,
[
"ధనదేన సమస్త్యాగే సత్యే ధర్మ ఇవాపరః ।",
"తమేవంగుణసమ్పన్నం రామం సత్యపరాక్రమమ్"
]
],
[
20,
[
"జ్యేష్ఠం జ్యేష్ఠగుణైర్యుక్తం ప్రియం దశరథస్సుతమ్ ।",
"ప్రకృతీనాం హితైర్యుక్తం ప్రకృతిప్రియకామ్యయా"
]
],
[
21,
[
"యౌవరాజ్యేన సంయోక్తుమ్ ఐచ్ఛత్ప్రీత్యా మహీపతిః ।",
"తస్యాభిషేకసమ్భారాన్ దృష్ట్వా భార్యాథ కైకయీ"
]
],
[
22,
[
"పూర్వం దత్తవరా దేవీ వరమేనమయాచత ।",
"వివాసనఞ్చ రామస్య భరతస్యాభిషేచనమ్"
]
],
[
23,
[
"స సత్యవచనాద్రాజా ధర్మపాశేన సంయతః ।",
"వివాసయామాస సుతం రామం దశరథః ప్రియమ్"
]
],
[
24,
[
"స జగామ వనం వీరః ప్రతిజ్ఞామనుపాలయన్ ।",
"పితుర్వచననిర్దేశాత్ కైకేయ్యాః ప్రియకారణాత్"
]
],
[
25,
[
"తం వ్రజన్తం ప్రియో భ్రాతా లక్ష్మణోఽనుజగామ హ ।",
"స్నేహాద్ వినయసమ్పన్నః సుమిత్రానన్దవర్ధనః"
]
],
[
26,
[
"భ్రాతరం దయితో భ్రాతుః సౌభ్రాత్రమనుదర్శయన్ ।",
"రామస్య దయితా భార్యా నిత్యం ప్రాణసమా హితా"
]
],
[
27,
[
"జనకస్య కులే జాతా దేవమాయేవ నిర్మితా ।",
"సర్వలక్షణసమ్పన్నా నారీణాముత్తమా వధూః"
]
],
[
28,
[
"సీతాప్యనుగతా రామం శశినం రోహిణీ యథా ।",
"పౌరైరనుగతో దూరం పిత్రా దశరథేన చ"
]
],
[
29,
[
"శృఙ్గవీరపురే సూతం గఙ్గాకూలే వ్యసర్జయత్ ।",
"గుహమాసాద్య ధర్మాత్మా నిషాదాధిపతిం ప్రియమ్"
]
],
[
30,
[
"గుహేన సహితో రామో లక్ష్మణేన చ సీతయా ।",
"తే వనేన వనఙ్గత్వా నదీస్తీర్త్వా బహూదకాః"
]
],
[
31,
[
"చిత్రకూటమనుప్రాప్య భరద్వాజస్య శాసనాత్ ।",
"రమ్యమావసథం కృత్వా రమమాణా వనే త్రయః"
]
],
[
32,
[
"దేవగన్ధర్వసంకాశాః తత్ర తే న్యవసన్ సుఖమ్ ।",
"చిత్రకూటఙ్గతే రామే పుత్రశోకాతురస్తథా"
]
],
[
33,
[
"రాజా దశరథస్స్వర్గం జగామ విలపన్ సుతమ్  ।",
"గతే తు తస్మిన్ భరతో వసిష్ఠప్రముఖైర్ద్విజైః"
]
],
[
34,
[
"నియుజ్యమానో రాజ్యాయ నైచ్ఛత్ రాజ్యం మహాబలః ।",
"స జగామ వనం వీరో రామపాదప్రసాదకః"
]
],
[
35,
[
"గత్వా తు స మహాత్మానం రామం సత్యపరాక్రమమ్ ।",
"అయాచద్భ్రాతరం రామమ్ ఆర్యభావపురస్కృతః"
]
],
[
36,
[
"త్వమేవ రాజా ధర్మజ్ఞ ఇతి రామం వచోఽబ్రవీత్ ।",
"రామోఽపి పరమోదారః సుముఖస్సుమహాయశాః"
]
],
[
37,
[
"న చైచ్ఛత్ పితురాదేశాత్ రాజ్యం రామో మహాబలః ।",
"పాదుకే చాస్య రాజ్యాయ న్యాసం దత్త్వా పునః పునః"
]
],
[
38,
[
"నివర్తయామాస తతో భరతం భరతాగ్రజః ।",
"స కామమనవాప్యైవ రామపాదావుపస్పృశన్"
]
],
[
39,
[
"నన్దిగ్రామేఽకరోద్ రాజ్యం రామాగమనకాఙ్క్షయా ।",
"గతే తు భరతే శ్రీమాన్ సత్యసన్ధో జితేన్ద్రియః"
]
],
[
40,
[
"రామస్తు పునరాలక్ష్య నాగరస్య జనస్య చ ।",
"తత్రాగమనమేకాగ్రో దణ్డకాన్ ప్రవివేశ హ"
]
],
[
41,
[
"ప్రవిశ్య తు మహారణ్యం రామో రాజీవలోచనః ।",
"విరాధం రాక్షసం హత్వా శరభఙ్గం దదర్శ హ"
]
],
[
42,
[
"సుతీక్ష్ణం చాప్యగస్త్యం చ అగస్త్యభ్రాతరం తథా ।",
"అగస్త్యవచనాచ్చైవ జగ్రాహైన్ద్రం శరాసనమ్"
]
],
[
43,
[
"ఖడ్గఞ్చ పరమ ప్రీతస్తూణీ చాక్షయసాయకౌ ।",
"వసతస్తస్య రామస్య వనే వనచరైః సహ"
]
],
[
44,
[
"ఋషయోఽభ్యాగమన్ సర్వే వధాయాసురరక్షసామ్ ।",
"స తేషాం ప్రతిశుశ్రావ రాక్షసానాం తదా వనే"
]
],
[
45,
[
"ప్రతిజ్ఞాతశ్చ రామేణ వధః సంయతి రక్షసామ్ ।",
"ఋషీణామగ్నికల్పానాం దణ్డకారణ్యవాసీనామ్"
]
],
[
46,
[
"తేన తత్రైవ వసతా జనస్థాననివాసినీ ।",
"విరూపితా శూర్పణఖా రాక్షసీ కామరూపిణీ"
]
],
[
47,
[
"తతః శూర్పణఖావాక్యాదుద్యుక్తాన్ సర్వరాక్షసాన్ ।",
"ఖరం త్రిశిరసం చైవ దూషణం చైవ రాక్షసమ్"
]
],
[
48,
[
"నిజఘాన రణే రామస్తేషాం చైవ పదానుగాన్ ।",
"వనే తస్మిన్ నివసతా జనస్థాననివాసినామ్"
]
],
[
49,
[
"రక్షసాం నిహతాన్యాసన్ సహస్రాణి చతుర్దశ ।",
"తతో జ్ఞాతివధం శ్రుత్వా రావణః క్రోధమూర్ఛితః"
]
],
[
50,
[
"సహాయం వరయామాస మారీచం నామ రాక్షసమ్ ।",
"వార్యమాణః సుబహుశో మారీచేన స రావణః"
]
],
[
51,
[
"న విరోధో బలవతా క్షమో రావణ తేన తే ।",
"అనాదృత్య తు తద్వాక్యం రావణః కాలచోదితః"
]
],
[
52,
[
"జగామ సహమారీచస్తస్యాశ్రమపదం తదా ।",
"తేన మాయావినా దూరమపవాహ్య నృపాత్మజౌ"
]
],
[
53,
[
"జహార భార్యాం రామస్య గృధ్రం హత్వా జటాయుషమ్ ।",
"గృధ్రఞ్చ నిహతం దృష్ట్వా హృతాం శ్రుత్వా చ మైథిలీమ్"
]
],
[
54,
